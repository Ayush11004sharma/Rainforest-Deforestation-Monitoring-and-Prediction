tent","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Missing Values After Feature Engineering","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"n1XwPbLFZ2"}],"identifier":"missing-values-after-feature-engineering","label":"Missing Values After Feature Engineering","html_id":"missing-values-after-feature-engineering","implicit":true,"key":"oKOsJUjdcY"}],"identifier":"a8ba4791","html_id":"a8ba4791","key":"Eu4gnkEJv0"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-20T18:45:14.101228Z","iopub.status.busy":"2026-11-20T18:45:14.101035Z","iopub.status.idle":"2026-11-20T18:45:14.109235Z","shell.execute_reply":"2026-11-20T18:45:14.108326Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"missing = featured[feature_cols].isnull().sum()\nprint('Missing values per feature:')\nfor feat, count in missing.items():\n    pct = count / len(featured) * 100\n    print(f'  {feat:40s} {count:4d} ({pct:.1f}%)')\n","key":"dqh1E56uUg"},{"type":"outputs","id":"99Hk2kMyWrXRpxXPUEDL7","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Missing values per feature:\n  tc_loss_ha_lag1                            27 (4.5%)\n  tc_loss_ha_lag2                            54 (9.1%)\n  tc_loss_ha_lag3                            81 (13.6%)\n  tc_loss_ha_roll_mean_3yr                   54 (9.1%)\n  tc_loss_ha_roll_std_3yr                    54 (9.1%)\n  tc_loss_ha_roll_mean_5yr                  108 (18.2%)\n  tc_loss_ha_roll_std_5yr                   108 (18.2%)\n  loss_change_1yr_lagged                     54 (9.1%)\n  loss_change_pct_1yr_lagged                 54 (9.1%)\n  loss_acceleration                          81 (13.6%)\n  loss_trend_3yr                             81 (13.6%)\n  loss_rate_pct_lag1                         27 (4.5%)\n  cumulative_loss_pct_lag1                   27 (4.5%)\n  loss_cv_5yr                                81 (13.6%)\n  region_encoded                              0 (0.0%)\n"},"children":[],"key":"ukioUXA8dn"}],"key":"pxMd0rGjZy"}],"identifier":"1957a123","html_id":"1957a123","key":"d82Uycd25Q"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Feature Documentation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DFcZjDJu1X"}],"identifier":"feature-documentation","label":"Feature Documentation","html_id":"feature-documentation","implicit":true,"key":"NocsasmkLn"}],"identifier":"6df62730","html_id":"6df62730","key":"tuD12EtAju"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-20T18:45:14.112076Z","iopub.status.busy":"2026-11-20T18:45:14.111735Z","iopub.status.idle":"2026-11-20T18:45:14.115248Z","shell.execute_reply":"2026-11-20T18:45:14.114394Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"print(FEATURE_DOCUMENTATION)\n","key":"jBkiBCobPH"},{"type":"outputs","id":"6Z38IHA7ujySJLbPXV-AS","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\nFeature Documentation\n=====================\n\nTarget Variable:\n  tc_loss_ha — Annual tree-cover loss in hectares for the given region and year.\n\nLag Features:\n  tc_loss_ha_lag1 — Tree-cover loss in the previous year.\n    Rationale: Most direct predictor; deforestation tends to persist year-over-year.\n    \n  tc_loss_ha_lag2 — Tree-cover loss two years prior.\n    Rationale: Captures medium-term persistence.\n    \n  tc_loss_ha_lag3 — Tree-cover loss three years prior.\n    Rationale: Captures longer-term baseline deforestation level.\n\nRolling Features:\n  tc_loss_ha_roll_mean_3yr — Mean loss over the prior 3 years.\n    Rationale: Smoothed estimate of recent deforestation activity.\n    \n  tc_loss_ha_roll_std_3yr — Standard deviation of loss over the prior 3 years.\n    Rationale: Captures volatility in recent deforestation.\n    \n  tc_loss_ha_roll_mean_5yr — Mean loss over the prior 5 years.\n    Rationale: Longer-term average deforestation level.\n    \n  tc_loss_ha_roll_std_5yr — Standard deviation of loss over the prior 5 years.\n    Rationale: Longer-term volatility measure.\n\nTrend Features:\n  loss_change_1yr_lagged — Year-over-year change in loss (previous year).\n    Rationale: Direction and magnitude of recent deforestation change.\n    \n  loss_change_pct_1yr_lagged — Percentage year-over-year change (previous year).\n    Rationale: Relative rate of change.\n    \n  loss_acceleration — Change in the year-over-year change.\n    Rationale: Whether deforestation is accelerating or decelerating.\n    \n  loss_trend_3yr — Linear trend slope over the prior 3 years (ha/year).\n    Rationale: Direction and steepness of recent trend.\n\nRate Features:\n  loss_rate_pct_lag1 — Previous year's forest-loss rate (%).\n    Rationale: Proportional loss relative to baseline.\n    \n  cumulative_loss_pct_lag1 — Previous year's cumulative loss as % of baseline.\n    Rationale: How much of original forest has been lost.\n\nVariability:\n  loss_cv_5yr — Coefficient of variation over trailing 5 years.\n    Rationale: Relative variability — identifies regions with erratic deforestation.\n\nRegion Encoding:\n  region_encoded — Integer-encoded region identifier.\n    Rationale: Allows tree-based models to learn region-specific patterns.\n\nLeakage Prevention:\n  - All lag and rolling features use shift(1) or earlier data only.\n  - Rolling windows exclude the current observation.\n  - Trend features are computed from historical values only.\n  - No future carbon emissions, future loss values, or test-period statistics\n    are used as features.\n\n"},"children":[],"key":"GWGJjUh0uG"}],"key":"MYcjpYz6Pq"}],"identifier":"5ee45bd4","html_id":"5ee45bd4","key":"J1pjN3e5oI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Conclusion","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WiLNlyiipO"}],"identifier":"conclusion","label":"Conclusion","html_id":"conclusion","implicit":true,"key":"M1Oi3ZXV76"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"15 leakage-safe features engineered from historical observations","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pgzHApb54y"}],"key":"D7Mrs5riAx"}],"key":"tJyhj4HsNI"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Lag features (1–3 years) have the highest correlation with the target","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"BT6HDg1GOd"}],"key":"bNa8aS7f3f"}],"key":"lIY7wDyQyG"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Rolling means smooth out year-to-year volatility","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"MAEJuB4aqS"}],"key":"qL7QviXRxZ"}],"key":"kP2HDqzRdA"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Trend and acceleration features capture directional changes","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"lbBbPteuXh"}],"key":"aw7UGO55Lu"}],"key":"mdCCwlwQbw"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Early years have missing features due to insufficient lag history","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"BFNHGunj79"}],"key":"XdiSGh7GFb"}],"key":"GND00Gnmj6"}],"key":"fkJ3MPX36l"}],"identifier":"03b7718d","html_id":"03b7718d","key":"rC1ENftOmO"}],"key":"C7gKww9wPA"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"02 — Exploratory Data Analysis","url":"/exploratory-analysis","group":"Analysis Notebooks"},"next":{"title":"04 — Model Training","url":"/model-training","group":"Analysis Notebooks"}}},"domain":"http://pre.render"}